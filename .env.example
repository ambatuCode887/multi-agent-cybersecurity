GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your_google_api_key_here

# Embeddings
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=multi_agentic_rag

# Confluence direct REST publishing
CONFLUENCE_BASE_URL=https://your-company.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here
CONFLUENCE_SPACE_KEY=YOUR_SPACE_KEY
CONFLUENCE_PARENT_ID=

# Optional Atlassian MCP bridge for Confluence publishing
# Use either CONFLUENCE_MCP_URL or CONFLUENCE_MCP_COMMAND.
ATLASSIAN_MCP_URL=
CONFLUENCE_MCP_URL=
CONFLUENCE_MCP_COMMAND=
CONFLUENCE_MCP_ARGS=

# Example MCP stdio configuration:
# CONFLUENCE_MCP_COMMAND=python
# CONFLUENCE_MCP_ARGS=-m,agents.mcp.confluence_server
